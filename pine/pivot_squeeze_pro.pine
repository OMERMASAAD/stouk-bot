//@version=5
// ═══════════════════════════════════════════════════════════════════════════
//  PIVOT SQUEEZE PRO  ·  مؤشر الانضغاط عند المحاور
//
//  نسخة التصميم النظيف (v3):
//   • لا علامات متكررة: كل تحذير يُرسم مرة واحدة عند تغيّر الحالة فقط.
//   • لا خطوط متدرجة: المستوى النشط فقط، كخط أفقي واحد من محوره إلى الآن،
//     داخل منطقة شفافة — بلا «سلالم» عبر التاريخ.
//   • لوحة بلا تشويش ثنائي الاتجاه: كل خلية نصٌّ باتجاه واحد فقط
//     (عربي صرف أو لاتيني/أرقام صرف) — لا خلط ولا رموز أسهم داخل العربي.
//   • هوية لونية واحدة من داشبورد «رادار القاع».
// ═══════════════════════════════════════════════════════════════════════════
indicator("Pivot Squeeze Pro | مؤشر الانضغاط عند المحاور", shorttitle = "Squeeze Pro",
     overlay = true, max_labels_count = 100, max_lines_count = 100, max_boxes_count = 20)

// ───────────────────────────────────────────────────────────────────────────
// 1) نظام الألوان (Brand Tokens)
// ───────────────────────────────────────────────────────────────────────────
C_BG     = color.new(#0a1710, 4)
C_PANEL  = color.new(#0e2117, 0)
C_BORDER = color.new(#214634, 20)
C_TEXT   = color.new(#f1fff6, 0)
C_MUTED  = color.new(#8fa99a, 0)
C_GREEN  = color.new(#20d47b, 0)
C_DEEP   = color.new(#16a85f, 0)
C_RED    = color.new(#ff5264, 0)
C_YELLOW = color.new(#ffc857, 0)
C_TEAL   = color.new(#7cf0d8, 0)

G_ON = color.new(#0d4d30, 8)
G_TX = color.new(#6dffb3, 0)
R_ON = color.new(#4a1a20, 8)
R_TX = color.new(#ff9aa5, 0)
Y_ON = color.new(#554314, 8)
Y_TX = color.new(#ffd978, 0)
T_ON = color.new(#123d3a, 8)
T_TX = C_TEAL
N_ON = color.new(#12291e, 0)
N_TX = color.new(#a9bbb0, 0)

// ───────────────────────────────────────────────────────────────────────────
// 2) المدخلات
// ───────────────────────────────────────────────────────────────────────────
GRP_UI = "① اللوحة والتصميم"
showDash  = input.bool(true , "عرض لوحة القرار", group = GRP_UI)
dashPos   = input.string("أعلى اليمين", "موضع اللوحة", options = ["أعلى اليمين", "أسفل اليمين", "أعلى اليسار", "أسفل اليسار"], group = GRP_UI)
showTags  = input.bool(true , "بطاقات الأسعار على المحور", group = GRP_UI)
showPlan  = input.bool(true , "خطة الصفقة عند الإشارة", group = GRP_UI)
showWarn  = input.bool(true , "علامة تحذير المطاردة", group = GRP_UI, tooltip = "تُرسم مرة واحدة فقط عند الدخول في حالة التشبع أو الامتداد.")
paintBars = input.bool(false, "تلوين الشموع", group = GRP_UI)

GRP_SR = "② الدعم والمقاومة"
pivotLen  = input.int(10 , "طول المحور", minval = 2, maxval = 50, group = GRP_SR)
showZones = input.bool(true , "منطقة شفافة حول المستوى", group = GRP_SR)
zoneAtr   = input.float(0.35, "عرض المنطقة (× ATR)", minval = 0.1, maxval = 2.0, step = 0.05, group = GRP_SR)
showSrLn  = input.bool(true , "خط منتصف المستوى", group = GRP_SR, tooltip = "خط أفقي رفيع واحد من المحور إلى الآن — بلا سلالم تاريخية.")

GRP_AN = "③ المرجع"
anchorLen     = input.int(20, "طول EMA على اليومي وأعلى", minval = 5, maxval = 200, group = GRP_AN)
vwapAnchorOpt = input.string("يومي", "مرتكز VWAP", options = ["يومي", "أسبوعي", "شهري"], group = GRP_AN)

GRP_SG = "④ الإشارة والمخاطر"
rsiLen     = input.int(14  , "طول RSI", minval = 2, group = GRP_SG)
rsiMin     = input.int(40  , "أدنى RSI للدخول", minval = 1, maxval = 70, group = GRP_SG)
rsiTrap    = input.int(80  , "حد التشبع الشرائي", minval = 60, maxval = 95, group = GRP_SG)
squeezeLen = input.int(20  , "طول قياس الانضغاط", minval = 10, maxval = 200, group = GRP_SG)
squeezePct = input.int(25  , "عتبة الانضغاط (مئوي)", minval = 5, maxval = 50, group = GRP_SG)
extMult    = input.float(2.5, "حد الامتداد عن المرجع (× ATR)", minval = 0.5, maxval = 10.0, step = 0.5, group = GRP_SG)
stopMult   = input.float(1.5, "مسافة الوقف (× ATR)", minval = 0.2, maxval = 10.0, step = 0.1, group = GRP_SG)
rrTarget   = input.float(2.0, "الهدف (عائد ÷ مخاطرة)", minval = 0.5, maxval = 10.0, step = 0.5, group = GRP_SG)

GRP_HT = "⑤ الفريم الأعلى"
htfOn     = input.bool(true, "اشتراط موافقة الفريم الأعلى", group = GRP_HT)
htfTf     = input.timeframe("D", "الفريم الأعلى", group = GRP_HT)
htfEmaLen = input.int(50, "طول EMA للفريم الأعلى", minval = 5, maxval = 200, group = GRP_HT)
htfRsiMin = input.int(50, "أدنى RSI للفريم الأعلى", minval = 1, maxval = 90, group = GRP_HT)

// ───────────────────────────────────────────────────────────────────────────
// 3) الحسابات
// ───────────────────────────────────────────────────────────────────────────
isHighTf = timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly
atr14    = ta.atr(14)

emaAnchor  = ta.ema(close, anchorLen)
vwapTf     = vwapAnchorOpt == "أسبوعي" ? "W" : vwapAnchorOpt == "شهري" ? "M" : "D"
vwapAnchor = ta.vwap(close, timeframe.change(vwapTf))
useVwap    = isHighTf ? false : not na(vwapAnchor)
anchorLine = useVwap ? vwapAnchor : emaAnchor
anchorName = useVwap ? "VWAP" : "EMA" + str.tostring(anchorLen)
aboveAnchor = not na(anchorLine) and close > anchorLine

obvVal = ta.obv
obvEma = ta.ema(obvVal, 20)
hasVol = not na(volume) and volume > 0
obvUp  = hasVol and obvVal > obvEma and ta.change(obvVal) > 0

rsiVal = ta.rsi(close, rsiLen)
rsiOk  = rsiVal > rsiMin and rsiVal < rsiTrap
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
macdBull = macdLine > signalLine and histLine > histLine[1]

basis   = ta.sma(close, squeezeLen)
dev     = ta.stdev(close, squeezeLen)
bbw     = basis != 0 ? (4 * dev) / basis * 100 : 0.0
bbwRank = ta.percentrank(bbw, squeezeLen)
bbwPct  = bar_index > squeezeLen ? bbwRank : 100.0
isSqueeze = bbwPct <= squeezePct

f_htf() => [close > ta.ema(close, htfEmaLen), ta.rsi(close, rsiLen)]
[htfTrendRaw, htfRsiRaw] = request.security(syminfo.tickerid, htfTf, f_htf(), barmerge.gaps_off, barmerge.lookahead_on)
htfTrend = na(htfTrendRaw[1]) ? false : htfTrendRaw[1]
htfRsi   = na(htfRsiRaw[1]) ? rsiVal : htfRsiRaw[1]
htfOk    = not htfOn or (htfTrend and htfRsi > htfRsiMin)

coreLong     = aboveAnchor and macdBull and obvUp and rsiOk and htfOk
buySignal    = coreLong and not coreLong[1]
squeezeBreak = isSqueeze[1] and not isSqueeze and close > close[1] and aboveAnchor and hasVol
stretched    = not na(anchorLine) and close > anchorLine + extMult * atr14
lateSignal   = aboveAnchor and (rsiVal >= rsiTrap or stretched)
lateFirst    = lateSignal and not lateSignal[1]     // مرة واحدة فقط

score = (aboveAnchor ? 1 : 0) + (macdBull ? 1 : 0) + (obvUp ? 1 : 0) + (rsiOk ? 1 : 0) + (isSqueeze ? 1 : 0) + (htfOk ? 1 : 0)

// ───────────────────────────────────────────────────────────────────────────
// 4) المستويات — النشط فقط، بلا تاريخ
// ───────────────────────────────────────────────────────────────────────────
pHi = ta.pivothigh(high, pivotLen, pivotLen)
pLo = ta.pivotlow(low , pivotLen, pivotLen)

var float lastRes = na
var float lastSup = na
var int   resBar  = na
var int   supBar  = na

if not na(pHi)
    lastRes := pHi
    resBar  := bar_index - pivotLen
if not na(pLo)
    lastSup := pLo
    supBar  := bar_index - pivotLen

plot(anchorLine, "المرجع", color = aboveAnchor ? color.new(C_GREEN, 45) : color.new(C_RED, 55), linewidth = 1)

zoneHalf = showZones ? math.max(atr14 * zoneAtr, syminfo.mintick) : 0.0

var box  resZone = na
var box  supZone = na
var line resLn   = na
var line supLn   = na

if barstate.islast
    if not na(lastRes) and not na(resBar)
        if showZones
            if na(resZone)
                resZone := box.new(resBar, lastRes + zoneHalf, bar_index + 12, lastRes - zoneHalf, bgcolor = color.new(C_RED, 92), border_color = color.new(C_RED, 100), border_width = 1)
            else
                box.set_lefttop(resZone, resBar, lastRes + zoneHalf)
                box.set_rightbottom(resZone, bar_index + 12, lastRes - zoneHalf)
        if showSrLn
            if na(resLn)
                resLn := line.new(resBar, lastRes, bar_index + 12, lastRes, xloc = xloc.bar_index, color = color.new(C_RED, 40), width = 1)
            else
                line.set_xy1(resLn, resBar, lastRes)
                line.set_xy2(resLn, bar_index + 12, lastRes)
    if not na(lastSup) and not na(supBar)
        if showZones
            if na(supZone)
                supZone := box.new(supBar, lastSup + zoneHalf, bar_index + 12, lastSup - zoneHalf, bgcolor = color.new(C_DEEP, 92), border_color = color.new(C_DEEP, 100), border_width = 1)
            else
                box.set_lefttop(supZone, supBar, lastSup + zoneHalf)
                box.set_rightbottom(supZone, bar_index + 12, lastSup - zoneHalf)
        if showSrLn
            if na(supLn)
                supLn := line.new(supBar, lastSup, bar_index + 12, lastSup, xloc = xloc.bar_index, color = color.new(C_DEEP, 35), width = 1)
            else
                line.set_xy1(supLn, supBar, lastSup)
                line.set_xy2(supLn, bar_index + 12, lastSup)

// ───────────────────────────────────────────────────────────────────────────
// 5) الإشارات — حدث واحد = علامة واحدة
// ───────────────────────────────────────────────────────────────────────────
plotshape(buySignal   , title = "إشارة دخول"   , style = shape.triangleup  , location = location.belowbar, color = C_GREEN , textcolor = C_GREEN, size = size.small, text = "دخول")
plotshape(squeezeBreak, title = "اختراق انضغاط", style = shape.circle      , location = location.belowbar, color = C_YELLOW, size = size.tiny)
plotshape(showWarn and lateFirst, title = "تحذير مطاردة", style = shape.triangledown, location = location.abovebar, color = color.new(C_RED, 25), size = size.tiny)

barcolor(paintBars ? buySignal ? C_GREEN : lateSignal ? color.new(C_RED, 85) : squeezeBreak ? color.new(C_YELLOW, 85) : na : na)

// بطاقات الأسعار
var label resTag = na
var label supTag = na
resTxt = "مقاومة " + str.tostring(lastRes, format.mintick)
supTxt = "دعم " + str.tostring(lastSup, format.mintick)
if showTags and barstate.islast
    if not na(lastRes)
        if na(resTag)
            resTag := label.new(bar_index, lastRes, resTxt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(C_RED, 88), textcolor = C_RED, size = size.tiny)
        else
            label.set_xy(resTag, bar_index, lastRes)
            label.set_text(resTag, resTxt)
    if not na(lastSup)
        if na(supTag)
            supTag := label.new(bar_index, lastSup, supTxt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(C_DEEP, 88), textcolor = G_TX, size = size.tiny)
        else
            label.set_xy(supTag, bar_index, lastSup)
            label.set_text(supTag, supTxt)
if not showTags and barstate.islast
    if not na(resTag)
        label.delete(resTag)
        resTag := na
    if not na(supTag)
        label.delete(supTag)
        supTag := na

// خطة الصفقة
var label planTag = na
var line  stopLn  = na
planTxt = ""
stopP   = float(na)
if buySignal
    entryP = close
    stopP := not na(lastSup) and lastSup < entryP ? math.min(lastSup - 0.25 * atr14, entryP - stopMult * atr14) : entryP - stopMult * atr14
    riskP  = math.max(entryP - stopP, syminfo.mintick)
    targP  = entryP + riskP * rrTarget
    planTxt := "دخول " + str.tostring(entryP, format.mintick) + "\nوقف " + str.tostring(stopP, format.mintick) + "\nهدف " + str.tostring(targP, format.mintick) + "\nعائد/مخاطرة " + str.tostring(rrTarget, "#.#")
if showPlan and barstate.islast and buySignal
    if na(planTag)
        planTag := label.new(bar_index, low - 1.5 * atr14, planTxt, xloc = xloc.bar_index, style = label.style_label_up, color = color.new(C_PANEL, 0), textcolor = C_TEXT, size = size.tiny)
    else
        label.set_xy(planTag, bar_index, low - 1.5 * atr14)
        label.set_text(planTag, planTxt)
    if na(stopLn)
        stopLn := line.new(bar_index - 3, stopP, bar_index + 10, stopP, xloc = xloc.bar_index, color = color.new(C_RED, 45), style = line.style_dashed, width = 1)
    else
        line.set_xy1(stopLn, bar_index - 3, stopP)
        line.set_xy2(stopLn, bar_index + 10, stopP)
if (not showPlan or not buySignal) and barstate.islast
    if not na(planTag)
        label.delete(planTag)
        planTag := na
    if not na(stopLn)
        line.delete(stopLn)
        stopLn := na

// ───────────────────────────────────────────────────────────────────────────
// 6) لوحة القرار — كل خلية اتجاه نصي واحد (بلا تشويش ثنائي الاتجاه)
// ───────────────────────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 9, bgcolor = C_BG, border_width = 1, border_color = C_BORDER, frame_color = color.new(C_DEEP, 55), frame_width = 1)
var bool dashAlive = true

dashPosFinal = dashPos == "أعلى اليمين" ? position.top_right : dashPos == "أسفل اليمين" ? position.bottom_right : dashPos == "أعلى اليسار" ? position.top_left : position.bottom_left

// نصوص عربية صرفة (بلا رموز ولا لاتيني) — القيم اللاتينية/الأرقام في خلية مستقلة
valAnchor = aboveAnchor ? "فوق" : "تحت"
valMacd   = macdBull ? "صاعد" : "ضعيف"
valObv    = not hasVol ? "بلا بيانات" : obvUp ? "داخل" : "خارج"
valRsi    = str.tostring(math.round(rsiVal, 1))
valSqz    = isSqueeze ? "انضغاط" : stretched ? "ممتد" : "طبيعي"
valHtf    = not htfOn ? "معطل" : htfTrend ? "داعم" : "معارض"
valScore  = str.tostring(score) + " من 6"
valJudge  = buySignal or coreLong ? "جاهز للدخول" : isSqueeze ? "انتظار الاختراق" : lateSignal ? "لا تطارد" : "لا صفقة"

if showDash and barstate.islast
    if not dashAlive
        dash := table.new(position.top_right, 2, 9, bgcolor = C_BG, border_width = 1, border_color = C_BORDER, frame_color = color.new(C_DEEP, 55), frame_width = 1)
        dashAlive := true
    table.set_position(dash, dashPosFinal)

    // الرأس: خلية عربية + خلية لاتينية منفصلة تمامًا
    table.cell(dash, 0, 0, "لوحة القرار", bgcolor = C_PANEL, text_color = C_TEXT, text_size = size.small)
    table.cell(dash, 1, 0, anchorName + " " + timeframe.period + " " + syminfo.ticker, bgcolor = C_PANEL, text_color = C_MUTED, text_size = size.tiny)

    table.cell(dash, 0, 1, "الموقع من المرجع", text_color = C_MUTED, text_size = size.small)
    table.cell(dash, 1, 1, valAnchor, bgcolor = aboveAnchor ? G_ON : R_ON, text_color = aboveAnchor ? G_TX : R_TX, text_size = size.small)

    table.cell(dash, 0, 2, "زخم الحركة", text_color = C_MUTED, text_size = size.small)
    table.cell(dash, 1, 2, valMacd, bgcolor = macdBull ? G_ON : R_ON, text_color = macdBull ? G_TX : R_TX, text_size = size.small)

    table.cell(dash, 0, 3, "تدفق السيولة", text_color = C_MUTED, text_size = size.small)
    table.cell(dash, 1, 3, valObv, bgcolor = not hasVol ? N_ON : obvUp ? G_ON : R_ON, text_color = not hasVol ? N_TX : obvUp ? G_TX : R_TX, text_size = size.small)

    table.cell(dash, 0, 4, "القوة النسبية", text_color = C_MUTED, text_size = size.small)
    table.cell(dash, 1, 4, valRsi, bgcolor = rsiVal >= rsiTrap ? R_ON : rsiOk ? G_ON : Y_ON, text_color = rsiVal >= rsiTrap ? R_TX : rsiOk ? G_TX : Y_TX, text_size = size.small)

    table.cell(dash, 0, 5, "حالة التذبذب", text_color = C_MUTED, text_size = size.small)
    table.cell(dash, 1, 5, valSqz, bgcolor = isSqueeze ? Y_ON : stretched ? R_ON : N_ON, text_color = isSqueeze ? Y_TX : stretched ? R_TX : N_TX, text_size = size.small)

    table.cell(dash, 0, 6, "الفريم الأكبر", text_color = C_MUTED, text_size = size.small)
    table.cell(dash, 1, 6, valHtf, bgcolor = not htfOn ? N_ON : htfTrend ? T_ON : R_ON, text_color = not htfOn ? N_TX : htfTrend ? T_TX : R_TX, text_size = size.small)

    table.cell(dash, 0, 7, "قوة الالتقاء", text_color = C_MUTED, text_size = size.small)
    table.cell(dash, 1, 7, valScore, bgcolor = score >= 5 ? G_ON : score >= 3 ? Y_ON : N_ON, text_color = score >= 5 ? G_TX : score >= 3 ? Y_TX : N_TX, text_size = size.small)

    table.cell(dash, 0, 8, "قرار النظام", text_color = C_TEXT, text_size = size.small)
    table.cell(dash, 1, 8, valJudge, bgcolor = buySignal or coreLong ? G_ON : isSqueeze ? Y_ON : lateSignal ? R_ON : N_ON, text_color = buySignal or coreLong ? G_TX : isSqueeze ? Y_TX : lateSignal ? R_TX : N_TX, text_size = size.small)

if not showDash and dashAlive and barstate.islast
    table.delete(dash)
    dashAlive := false

// ───────────────────────────────────────────────────────────────────────────
// 7) التنبيهات
// ───────────────────────────────────────────────────────────────────────────
alertcondition(buySignal   , title = "إشارة دخول نظيفة"   , message = "🟢 {{ticker}} على {{interval}} — التقاء كامل: فوق المرجع، زخم صاعد، تدفق سيولة داخل، والفريم الأعلى موافق.")
alertcondition(squeezeBreak, title = "اختراق انضغاط"      , message = "🟡 {{ticker}} على {{interval}} — انتهى الانضغاط وبدأ التمدد لأعلى مع المرجع والفوليوم.")
alertcondition(lateFirst   , title = "تحذير مطاردة"       , message = "🔴 {{ticker}} على {{interval}} — دخل الآن منطقة التشبع أو الامتداد: الدخول مخاطرة عالية.")
alertcondition(ta.crossover(close, lastRes) , title = "اختراق المقاومة", message = "🚀 {{ticker}} على {{interval}} — اختراق آخر مقاومة هيكلية.")
alertcondition(ta.crossunder(close, lastSup), title = "كسر الدعم"      , message = "⚠️ {{ticker}} على {{interval}} — كسر آخر دعم هيكلي: إلغاء الفكرة.")
